# Cadiilac AI — server-side secrets.
#
# These values are set on the Supabase project (Edge Function secrets), never in
# the browser bundle:
#   supabase secrets set --env-file .env
#
# Users of the product never supply any of these.

# Supabase (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are
# injected automatically inside deployed Edge Functions; set them only for local
# `supabase functions serve`).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# AI — https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR-OPENROUTER-KEY
OPENROUTER_MODEL=openai/gpt-4o-mini

# Voice — https://elevenlabs.io
ELEVENLABS_API_KEY=YOUR-ELEVENLABS-KEY
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Platform
PUBLIC_SITE_URL=https://cadiilac.ai
ALLOWED_ORIGIN=*
STORAGE_BUCKET=drive
# Salt mixed into Cadiilac API key hashes. Change once, before creating keys.
API_KEY_PEPPER=change-me
# Allow switching plans from Settings without a payment provider (dev only).
ALLOW_SELF_SERVE_PLAN_SWITCH=false
